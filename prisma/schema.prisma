datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  KITCHEN
  COURIER
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  ACCEPTED
  KITCHEN_PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  PAYMOB_CARD
  INSTAPAY_WALLET
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?  // Hashed via bcryptjs (nullable for guest checkout accounts)
  role         Role     @default(CUSTOMER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  nameAr      String
  slug        String     @unique
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model MenuItem {
  id              String            @id @default(uuid())
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  nameAr          String
  description     String
  descriptionAr   String
  imageUrl        String
  basePrice       Decimal           @db.Decimal(12, 2)
  isAvailable     Boolean           @default(true)
  isArchived      Boolean           @default(false)
  isPopular       Boolean           @default(false)
  isSpicy         Boolean           @default(false)
  isVegetarian    Boolean           @default(false)
  calories        Int?
  prepTimeMinutes Int               @default(15)
  optionGroups    ItemOptionGroup[]
  orderItems      OrderItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId, isAvailable])
  @@index([isArchived])
  @@index([isPopular])
}

model ItemOptionGroup {
  id          String       @id @default(uuid())
  menuItemId  String
  menuItem    MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String
  minSelect   Int          @default(0)
  maxSelect   Int          @default(1)
  isRequired  Boolean      @default(false)
  options     ItemOption[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([menuItemId])
}

model ItemOption {
  id            String          @id @default(uuid())
  optionGroupId String
  optionGroup   ItemOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name          String
  nameAr        String
  priceDelta    Decimal         @default(0) @db.Decimal(12, 2)
  isDefault     Boolean         @default(false)
  isAvailable   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([optionGroupId, isAvailable])
}

model DeliveryZone {
  id               String   @id @default(uuid())
  zoneName         String   @unique
  zoneNameAr       String
  deliveryFee      Decimal  @db.Decimal(12, 2)
  estimatedMinutes Int      @default(40)
  isActive         Boolean  @default(true)
  orders           Order[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

model Coupon {
  id                 String   @id @default(uuid())
  code               String   @unique
  discountPercentage Decimal  @db.Decimal(5, 2)
  maxDiscount        Decimal? @db.Decimal(12, 2)
  minOrderAmount     Decimal  @default(0) @db.Decimal(12, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Order {
  id                 String          @id @default(uuid())
  orderNumber        String          @unique // e.g. #FC-8921
  userId             String?
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  fulfillmentType    FulfillmentType @default(DELIVERY)
  status             OrderStatus     @default(PENDING)
  
  // Customer & Delivery Details
  customerName       String
  customerPhone      String
  customerEmail      String?
  deliveryZoneId     String?
  deliveryZone       DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryAddress    String?
  building           String?
  floor              String?
  apartment          String?
  deliveryNotes      String?
  
  // Financial Breakdowns (Exact Decimal representation)
  subtotal           Decimal         @default(0) @db.Decimal(12, 2)
  deliveryFee        Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2) // 14% VAT
  discountAmount     Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(12, 2)
  
  // Payment
  paymentMethod      PaymentMethod   @default(CASH_ON_DELIVERY)
  paymentStatus      PaymentStatus   @default(UNPAID)
  paymentGatewayRef  String?
  
  // Kitchen & Delivery Timestamps
  estimatedMinutes   Int             @default(40)
  acceptedAt         DateTime?
  preparedAt         DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  
  items              OrderItem[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
}

model OrderItem {
  id                     String   @id @default(uuid())
  orderId                String
  order                  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId             String
  menuItem               MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity               Int      @default(1)
  unitPrice              Decimal  @db.Decimal(12, 2) // Frozen price including selected options
  totalPrice             Decimal  @db.Decimal(12, 2)
  selectedOptionsSummary String?  // e.g. "Large 13", Stuffed Cheesy Crust, Extra Jalapeño (+15 EGP)"
  selectedOptionsJson    String?  // JSON serialized choices
  specialInstructions    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}

